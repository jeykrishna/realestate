# PlotBook Backend — environment variables
# Copy to .env for local dev, or set these as env vars in your deploy platform
# (Render/Railway/EC2). Never commit a real .env file.

# --- App ---
APP_NAME=PlotBook
APP_ENV=development
# Long random string. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Comma-separated list of origins allowed to call the API (your frontend URL(s))
ALLOWED_ORIGINS=http://localhost:3000

# --- Database ---
DATABASE_URL=postgresql://plotbook_user:password@localhost:5432/plotbook_db

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
OTP_TTL_SECONDS=600

# --- JWT ---
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# --- First-admin bootstrap ---
# Leave blank in normal operation. Only set + supply matching X-Setup-Token
# header to enable anonymous registration via POST /auth/register.
SETUP_TOKEN=
# Change these from the repo defaults before deploying to production.
ADMIN_SECRET_KEY=
SUPER_ADMIN_SECRET_KEY=

# --- Email (AWS SES) ---
EMAIL_FROM=noreply@plotbook.in
EMAIL_FROM_NAME=PlotBook
AWS_SES_REGION=eu-north-1

# --- SMS (AWS SNS) ---
AWS_SNS_REGION=eu-north-1

# --- AWS credentials (shared by SES, SNS, S3) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Media storage ---
# "local" writes to /tmp/plotbook-uploads (fine for dev, NOT durable on most
# hosting platforms — use "s3" in production).
MEDIA_STORAGE=local
S3_BUCKET_NAME=plotbook-media
S3_REGION=eu-north-1
# Public base URL for served media (CDN or S3 virtual-hosted URL). Leave blank
# to fall back to the S3 URL.
CDN_BASE_URL=

# --- Anthropic (AI layout analysis) ---
ANTHROPIC_API_KEY=

# --- Rate limiting ---
RATE_LIMIT_PUBLIC=60/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_OTP=3/15minutes
RATE_LIMIT_DEFAULT=240/minute
